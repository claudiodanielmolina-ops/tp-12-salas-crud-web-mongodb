<section class="panel-formulario">
    <p class="etiqueta">
        <%= seccion %>
    </p>
    <h1>
        <%= titulo %>
    </h1>

    <% if (error) { %>
        <p class="error" role="alert">
            <%= error %>
        </p>
        <% } %>

            <article class="tarjeta-reserva" style="margin-bottom: 1.25rem;">
                <div class="reserva-cabecera">
                    <span class="reserva-id">ID: <%= id %></span>
                    <span class="badge-turno" data-turno="<%= reserva.turno %>">
                        <%= reserva.turno %>
                    </span>
                </div>
                <h2 class="reserva-sala">
                    <%= reserva.sala %>
                </h2>
                <div class="reserva-estudiante">
                    <p class="nombre">
                        <%= reserva.estudiante %>
                    </p>
                    <p class="email">
                        <%= reserva.email %>
                    </p>
                </div>
                <div class="reserva-detalles">
                    <span class="reserva-fecha">📅 <%= reserva.fecha %></span>
                    <span class="reserva-personas">👥 <%= reserva.personas %>
                            <%= reserva.personas===1 ? 'persona' : 'personas' %></span>
                    <span class="reserva-estado">📌 Actual: <strong>
                            <%= reserva.estado %>
                        </strong></span>
                </div>
            </article>

            <form action="/reservas/<%= id %>/estado" method="post" class="formulario">
                <label for="estado">Nuevo estado</label>
                <select id="estado" name="estado" required>
                    <option value="pendiente" <%=estadoSeleccionado==='pendiente' ? 'selected' : '' %>>pendiente
                    </option>
                    <option value="confirmada" <%=estadoSeleccionado==='confirmada' ? 'selected' : '' %>>confirmada
                    </option>
                </select>

                <div style="display: flex; gap: 0.75rem; align-items: center; margin-top: 0.5rem;">
                    <button type="submit">Guardar estado</button>
                    <a href="/reservas/<%= id %>" class="boton">Cancelar</a>
                </div>
            </form>
</section>